MAX_UPLOAD_SIZE_MB=25
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=vector_store
VECTOR_COLLECTION_NAME=document_chunks
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
