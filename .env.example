# Local development configuration. Keep this file private and never commit it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_random_64_character_password
POSTGRES_DB=ai_document_rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_random_64_character_password@localhost:5433/ai_document_rag
# Optional migration-only connection; leave empty to derive it from DATABASE_URL.
SYNC_DATABASE_URL=
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,https://docu-mind-ai-bda4.vercel.app,https://docu-mind-ai-omega-five.vercel.app
MAX_UPLOAD_SIZE_MB=25
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=vector_store
VECTOR_COLLECTION_NAME=document_chunks
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=300
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_TIMEOUT_SECONDS=90
VITE_API_BASE_URL=http://localhost:8000
