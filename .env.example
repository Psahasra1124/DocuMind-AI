POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_random_64_character_password@localhost:5433/ai_document_rag
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
